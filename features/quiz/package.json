{
  "name": "@platform/quiz",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data.ts",
    "./outline": "./src/outline/outline.ts",
    "./play": "./src/lib/quiz.ts",
    "./saved": "./src/lib/load.ts",
    "./session": "./src/lib/session.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc",
    "lint-prettier": "prettier --check .",
    "lint-eslint": "eslint .",
    "clean": "rm -rf node_modules/.cache tsconfig.tsbuildinfo",
    "start": "node --experimental-strip-types src/index.ts"
