{
  "name": "project-course",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "start": "pnpm --filter @app/cli start",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t lint-typecheck",
    "format:check": "prettier --check .",
    "lint-typecheck": "nx run-many -t lint-typecheck",
    "lint-eslint": "nx run-many -t lint-eslint",
    "lint-prettier": "nx run-many -t lint-prettier",
    "clean": "nx run-many -t clean && nx reset"
  },
  "devDependencies": {
    "nx": "^24.0.1",
    "prettier": "catalog:"
  }
}
